msgid "Choose a date:"
msgstr "Sanani tanlang:"

#: handlers/booking.py:184 handlers/booking.py:198
#, python-brace-format
msgid ""
"The duration of your chosen service \"{service_title}\" is "
"{service_duration} minutes.\n"
"Choose the timeframe of your booking:"
msgstr ""
"Siz tanlagan \"{service_title}\" xizmatining davomiyligi: "
"{service_duration} daqiqa.\n"
"Band qilish vaqt oraligʻini tanlang:"

#: handlers/booking.py:213
msgid "Choose which of the following options applies to your reservation/booking:"
msgstr ""
"Quyidagi variantlardan qaysi biri sizning bron/buyurtmangizga to'g'ri "
"kelishini tanlang:"

#: handlers/booking.py:223 handlers/booking.py:232
msgid "Choose the number of guests:"
msgstr "Mehmonlar sonini tanlang:"

#: handlers/booking.py:240
msgid "Choose additional products alongside your reservation or skip this step"
msgstr ""
"Zaxirangizga qo'shimcha mahsulotlarni tanlang yoki bu bosqichni o'tkazib "
"yuboring"

#: handlers/booking.py:247
msgid "Leave an additional message (or click the skip button)"
msgstr "Qoʻshimcha xabar qoldiring (yoki oʻtkazib yuborish tugmasini bosing)"

#: handlers/booking.py:284
msgid "Gym"
msgstr "Fitnes zal"

#: handlers/booking.py:285
msgid "Spa"
msgstr "Spa"

#: handlers/booking.py:286
msgid "Salon"
msgstr "Goʻzallik saloni"

#: handlers/booking.py:287
msgid "Clinic"
msgstr "Klinika"

#: handlers/booking.py:292
#, python-brace-format
msgid ""
"Your total price is {total_price}\n"
"Please make sure your booking details are correct:\n"
"    \n"
"Company name: {business_name}\n"
"Chosen service: {service_title}\n"
"Service duration: {service_duration} minutes\n"
"Booked date: {booking_date}\n"
"Booked timeslot: {start_time} - {end_time}"
msgstr ""
"Jami narxingiz {total_price}\n"
"Iltimos, bron qilish ma'lumotlaringiz to'g'ri ekanligiga ishonch hosil "
"qiling:\n"
"\n"
"Kompaniya nomi: {business_name}\n"
"Tanlangan xizmat: {service_title}\n"
"Xizmat davomiyligi: {service_duration} daqiqa\n"
"Bron qilingan sana: {booking_date}\n"
"Bron qilingan vaqt oralig'i: {start_time} - {end_time}"

#: handlers/booking.py:308
#, python-brace-format
msgid ""
"\n"
"Additional note: {note}"
msgstr ""
"\n"
"Qo'shimcha izoh: {note}"

#: handlers/booking.py:310
#, python-brace-format
msgid ""
"\n"
"Guests invited: {guest_count}"
msgstr ""
"\n"
"Taklif etilgan mehmonlar soni: {guest_count}"

