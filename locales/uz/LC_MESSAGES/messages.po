msgstr "Kategoriyalar bo'yicha kompaniyalarni tanlang"

#: keyboards/keyboard_booking.py:17
msgid "Search Companies"
msgstr "Kompaniyalarni qidirish"

#: keyboards/keyboard_booking.py:25 keyboards/keyboard_booking.py:36
#: keyboards/keyboard_booking.py:53 keyboards/keyboard_booking.py:72
msgid "Return to Booking Menu"
