msgstr "Davom eting va tanlangan mahsulot(lar)ni buyurtma qiling ({product_qty})"

#: keyboards/keyboard_booking.py:215
msgid "Skip this step (this will remove any chosen products)"
msgstr ""
"Ushbu bosqichni o'tkazib yuboring (bu tanlangan mahsulotlarni olib "
"tashlaydi)"

#: keyboards/keyboard_booking.py:217
msgid "Return choosing the number of guests"
msgstr "Mehmonlar sonini tanlashga qaytish"

#: keyboards/keyboard_booking.py:225
msgid "Skip this step"
msgstr "Ushbu qadamni o'tkazib yuboring"

#: keyboards/keyboard_booking.py:226
msgid "Return to choosing products"
msgstr "Mahsulotlarni tanlashga qaytish"

#: keyboards/keyboard_booking.py:233
