#: handlers/auth.py:40
msgid ""
"Welcome to Bron. You are currently not logged in.\n"
"Share contact information in order to log in or register:"
msgstr ""
"Bron-ga xush kelibsiz. Siz tizimga kirmagansiz.\n"
"Tizimga kirish yoki roʻyxatdan oʻtish uchun kontakt maʼlumotlaringizni "
"ulashing:"

#: handlers/auth.py:45
msgid "You are already logged in."
msgstr "Siz allaqachon tizimga kirgansiz."

#: handlers/auth.py:52
msgid "Registration is completed!"
msgstr "Roʻyxatdan oʻtish muvaffaqiyatli yakunlandi!"

#: handlers/auth.py:54
#, python-brace-format
msgid ""
"This is a test message: if you are seeing this, the app is still in "
"development.\n"
"        There is no account with your phone number registered on the "
"database. Sign up on the website: {website}"
msgstr ""
"Bu test xabari: agar buni ko'rayotgan bo'lsangiz, ilova hali rivojlanish "
"jarayonida.\n"
" Ma'lumotlar bazasida telefon raqamingiz bilan hech qanday hisob "
"ro'yxatdan o'tmagan. Veb-saytda ro'yxatdan o'ting: {website}"

#: handlers/base.py:39 handlers/base.py:42
msgid "An unexpected error occurred, please run the /start command again"
msgstr "Kutilmagan xatolik yuz berdi, /start buyrug'ini qaytadan ishga tushiring"

