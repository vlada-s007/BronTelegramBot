#, python-brace-format
msgid ""
"\n"
"Total Price of products: {products_price}"
msgstr ""
"\n"
"Mahsulotlarning jami narxi: {products_price}"

#: handlers/booking.py:367
#, python-brace-format
msgid ""
"\n"
"Additional note: {note}"
msgstr ""
"\n"
"Qo'shimcha izoh: {note}"

