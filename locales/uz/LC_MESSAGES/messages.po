#: handlers/auth.py:36
#, python-brace-format
msgid ""
"Welcome to Bron, {username}. You are currently not logged in.\n"
"Share contact information in order to log in or register:"
msgstr ""
"Bron-ga xush kelibsiz, {username}. Siz tizimga kirmagansiz.\n"
"Tizimga kirish yoki roʻyxatdan oʻtish uchun kontakt maʼlumotlaringizni "
"ulashing:"

#: handlers/auth.py:42
msgid "You are already logged in."
msgstr "Siz allaqachon tizimga kirgansiz."

#: handlers/auth.py:49
msgid "Registration is completed!"
msgstr "Roʻyxatdan oʻtish muvaffaqiyatli yakunlandi!"

#: handlers/base.py:24 handlers/base.py:26 handlers/base.py:42
#: handlers/base.py:44
msgid "Welcome to Bron. Choose your actions:"
msgstr "Bron-ga xush kelibsiz. Harakatni tanlang:"

#: handlers/base.py:31
msgid "Choose your language:"
msgstr "Tilni tanlang:"

#: handlers/base.py:40
msgid "Language set successfully."
msgstr "Til muvaffaqiyatli oʻrnatildi."

#: handlers/base.py:49 handlers/base.py:54 handlers/base.py:58
