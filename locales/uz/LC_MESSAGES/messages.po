msgid "Return to choosing your booking/reservation timeframe"
msgstr "Band qilish vaqt oraligʻini tanlashga qaytish"

#: keyboards/keyboard_booking.py:200 keyboards/keyboard_booking.py:234
msgid "Return to choosing your booking/reservation type"
msgstr "Band qilish turini tanlashga qaytish"

#: keyboards/keyboard_booking.py:225
#, python-brace-format
msgid ""
"Proceed and order chosen product(s) - ({product_qty} products, +{price} som)"
msgstr ""
"Davom etish va tanlangan mahsulot(lar)ni buyurtma qilish ({product_qty}, "
"mahsulot(lar) +{price} som)"

#: keyboards/keyboard_booking.py:229
msgid "Skip this step (this will remove any chosen products)"
msgstr ""
"Ushbu bosqichni oʻtkazib yuborish (bu tanlangan mahsulotlarni olib tashlaydi)"

#: keyboards/keyboard_booking.py:232
msgid "Return choosing the number of guests"
msgstr "Mehmonlar sonini tanlashga qaytish"

#: keyboards/keyboard_booking.py:240
msgid "Skip this step"
msgstr "Ushbu qadamni o'tkazib yuboring"

#: keyboards/keyboard_booking.py:241
msgid "Return to choosing products"
msgstr "Mahsulotlarni tanlashga qaytish"

#: keyboards/keyboard_booking.py:248
msgid "Confirm reservation/booking"
msgstr "Band qilishni tasdiqlash"

#: keyboards/keyboard_booking.py:249
msgid "Cancel reservation/booking and return to the main menu"
msgstr "Band qilishni bekor qilish va asosiy menyuga qaytish"

