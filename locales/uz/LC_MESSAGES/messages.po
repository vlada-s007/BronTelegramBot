#, python-brace-format
msgid "{amt} Companies found in \"{category}\" category"
msgstr "\"{category}\" kategoriyasida {amt} ta kompaniya topildi"

#: handlers/booking.py:57
msgid "Enter your search query:"
msgstr "Qidiruv soʻrovini kiriting:"

#: handlers/booking.py:70 handlers/booking.py:88 handlers/booking.py:91
