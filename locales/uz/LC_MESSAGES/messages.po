msgid "Return to choosing a branch/subsidiary"
msgstr "Filialni tanlashga qaytish"

#: keyboards/keyboard_booking.py:108
msgid "Return to choosing services"
msgstr "Xizmatlarni tanlashga qaytish"

#: keyboards/keyboard_booking.py:165 keyboards/keyboard_booking.py:168
msgid "Return to choosing a date of your reservation"
msgstr "Zaxirangiz sanasini tanlashga qaytish"

#: keyboards/keyboard_booking.py:175 keyboards/keyboard_booking.py:199
msgid "I'm making a reservation for myself only"
msgstr "Faqat oʻzim uchun joy band qilyapman"

